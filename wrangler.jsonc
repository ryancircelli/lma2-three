// Cloudflare Worker: a password gate (worker/index.ts) in front of the static
// site in _site/. Deployed by .github/workflows/deploy.yml.
{
  "name": "lma2-three",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // Essential: without this, Cloudflare serves any file that matches a static
    // asset directly, WITHOUT running the Worker - bypassing the password.
    "run_worker_first": true
  },
  "workers_dev": true,
  // Per-version preview URLs are extra hostnames; keep them off.
  "preview_urls": false
}
